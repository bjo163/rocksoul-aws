# Coolify deployment secrets
POSTGRES_DB=moonwitness
POSTGRES_USER=moonwitness
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
MW_ADMIN_RID=RID-REPLACE-WITH-VERIFIED-OPERATOR

# Public browser origin(s), comma-separated
MW_CORS_ORIGINS=https://cosmic.example.com
MW_COOKIE_SECURE=1
MW_COOKIE_SAME_SITE=Lax
MW_TRUST_PROXY=1

# Coolify domains are configured on the API and Web services.
# API example: https://api.example.com
# Web example: https://cosmic.example.com
