{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.dev/schemas/aws/cross-repo-graph.schema.json",
  "title": "AWS Cross-Repository Case Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "case_ref",
    "node_refs",
    "edges",
    "research_state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CGRAPH-[A-Z0-9][A-Z0-9._-]*$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^CASE-AWS-"
    },
    "node_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from_ref",
          "relation",
          "to_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GEDGE-[A-F0-9]{24}$"
          },
          "from_ref": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "CASE_HAS_STORY",
              "CASE_HAS_EVENT",
              "CASE_HAS_PERSON",
              "CASE_HAS_RGBL",
              "CASE_HAS_LEGAL_BASIS",
              "CASE_HAS_APPLICABILITY",
              "CASE_HAS_CLAIM",
              "CASE_HAS_ASSESSMENT"
            ]
          },
          "to_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "research_state": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "REVIEW_REQUIRED",
        "REVIEWED",
        "SUPERSEDED"
      ]
    }
  }
}
