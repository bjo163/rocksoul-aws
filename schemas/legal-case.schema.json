{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.dev/schemas/aws/legal-case.schema.json",
  "title": "AWS Legal Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "question",
    "event_date",
    "actors",
    "legal_basis_refs",
    "jurisdiction_refs",
    "authority_refs",
    "applicability_refs",
    "claim_refs",
    "assessment_refs",
    "research_state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LCASE-[A-Z0-9][A-Z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "legal_basis_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^LAW-"
      },
      "uniqueItems": true
    },
    "jurisdiction_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^JUR-"
      },
      "uniqueItems": true
    },
    "authority_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AUTH-"
      },
      "uniqueItems": true
    },
    "applicability_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^APPL-"
      },
      "uniqueItems": true
    },
    "claim_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^LCLAIM-"
      },
      "uniqueItems": true
    },
    "assessment_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^LASSMT-"
      },
      "uniqueItems": true
    },
    "research_state": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "REVIEW_REQUIRED",
        "REVIEWED",
        "SUPERSEDED"
      ]
    }
  }
}
