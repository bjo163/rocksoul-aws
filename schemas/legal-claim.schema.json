{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.dev/schemas/aws/legal-claim.schema.json",
  "title": "AWS Legal Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "case_ref",
    "proposition",
    "claim_type",
    "basis_refs",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LCLAIM-[A-Z0-9][A-Z0-9._-]*$"
    },
    "case_ref": {
      "type": "string",
      "minLength": 1
    },
    "proposition": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "permission",
        "restriction",
        "prohibition",
        "obligation",
        "exception",
        "jurisdiction",
        "applicability",
        "interpretation",
        "responsibility",
        "remedy",
        "procedure",
        "other"
      ]
    },
    "asserted_by_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "basis_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contrary_authority_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "counterclaim_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scope_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "SUPPORTED",
        "DISPUTED",
        "CONTRADICTED",
        "UNRESOLVED",
        "SUPERSEDED"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  }
}
