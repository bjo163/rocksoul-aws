{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.dev/schemas/aws/legal-source.schema.json",
  "title": "AWS Legal Source Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "publisher",
    "authority_role",
    "canonical_url",
    "scope",
    "retrieved_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SRC-AWS-[A-Z0-9][A-Z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "authority_role": {
      "type": "string",
      "enum": [
        "OFFICIAL_DEPOSITARY",
        "OFFICIAL_JUDICIAL",
        "OFFICIAL_INSTITUTIONAL_DATABASE",
        "OTHER_OFFICIAL"
      ]
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
