{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.dev/schemas/aws/source-freshness.schema.json",
  "title": "AWS Source Freshness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_ref",
    "freshness_state",
    "change_state",
    "last_checked_at",
    "last_success_at",
    "last_change_at",
    "next_due_at",
    "consecutive_failures"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FRESH-AWS-"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^SRC-AWS-"
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "FRESH",
        "STALE",
        "UNAVAILABLE"
      ]
    },
    "change_state": {
      "type": "string",
      "enum": [
        "UNCHANGED",
        "CHANGED",
        "REVIEW_REQUIRED"
      ]
    },
    "last_checked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_success_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_change_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "next_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "consecutive_failures": {
      "type": "integer",
      "minimum": 0
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
