{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:moonwitness:semantic-observation",
  "title":"MoonWitness Semantic Observation v1",
  "type":"object",
  "additionalProperties":true,
  "required":["status","intention","actionGateVector","impactVector"],
  "properties":{
    "status":{"type":"string"},
    "mode":{"type":"string"},
    "action":{"type":"string"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "intention":{"type":"object","required":["rgbl"],"properties":{"label":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1},"rgbl":{"$ref":"urn:moonwitness:rgbl"},"chain":{"type":"array"}}},
    "actionGateVector":{"type":"array","minItems":9,"maxItems":9,"items":{"type":"number","minimum":-1,"maximum":1}},
    "impactVector":{"type":"array","minItems":13,"maxItems":13,"items":{"type":"number","minimum":-1,"maximum":1}},
    "timeFactor":{"type":"object"},
    "causality":{"type":"object"},
    "domainVector":{"type":"object","additionalProperties":{"type":"number","minimum":0,"maximum":1}},
    "evidence":{"type":"array"},
    "alternatives":{"type":"array"},
    "conflicts":{"type":"array"}
  }
}
