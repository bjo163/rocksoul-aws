{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.dev/schemas/aws/repository-binding.schema.json",
  "title": "AWS Cross-Repository Binding Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "bindings"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "repository",
          "ref_prefix",
          "ownership"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "enum": [
              "STORY",
              "EVENT",
              "PERSON",
              "RGBL"
            ]
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "ref_prefix": {
            "type": "string",
            "minLength": 1
          },
          "ownership": {
            "type": "string",
            "const": "FOREIGN"
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^BIND-AWS-[A-Z0-9][A-Z0-9._-]*$"
    }
  }
}
