{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "types": [
      "node"
    ],
    "allowJs": false
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "../../src/backend/**/*.ts"
  ]
}
