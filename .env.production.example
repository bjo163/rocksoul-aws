# Production deployment template
# Store these values in Coolify secrets, never commit real values.

STORAGE_DRIVER=postgres
PGHOST=postgres
PGPORT=5432
PGDATABASE=moonwitness
PGUSER=moonwitness
PGPASSWORD=REPLACE_IN_SECRET_STORE

JWT_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
MOONWITNESS_ADMIN_RID=RID-REPLACE-WITH-VERIFIED-OPERATOR
MOONWITNESS_ENV=production
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

MW_JWT_ISSUER=moonwitness-api
MW_JWT_AUDIENCE=moonwitness-clients
MW_ACCESS_TOKEN_TTL_MS=900000
MW_REFRESH_TOKEN_TTL_MS=2592000000

MW_CORS_ORIGINS=https://REPLACE-WEB-DOMAIN
MW_COOKIE_SECURE=1
MW_COOKIE_SAME_SITE=Lax
MW_TRUST_PROXY=1

MW_RATE_LIMIT_PER_MINUTE=600
MW_AUTH_RATE_LIMIT_PER_MINUTE=30
MW_AI_RATE_LIMIT_PER_MINUTE=30
MW_WRITE_RATE_LIMIT_PER_MINUTE=120
MW_RATE_LIMIT_MAX_BUCKETS=10000

WITNESS_ID=SERVICE-WITNESS-001
WITNESS_KEY_PASSWORD=REPLACE_IN_SECRET_STORE
WITNESS_AUTO_CHECKPOINT=1
