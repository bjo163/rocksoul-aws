{
  "name": "@moonwitness/intelligence",
  "version": "4.33.0",
  "description": "Composable, host-neutral MoonWitness intelligence facade used by AWS",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck src/index.ts",
    "test": "tsx --test test/intelligence.test.ts"
  },
  "dependencies": {
    "@moonwitness/explanation-engine": "4.33.0",
    "@moonwitness/mizan-engine": "4.33.0",
    "@moonwitness/semantic-engine": "4.33.0",
    "@moonwitness/temporal-engine": "4.33.0",
    "@moonwitness/tse-engine": "4.33.0",
    "@moonwitness/workflow": "4.33.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
