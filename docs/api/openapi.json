{
  "openapi": "3.1.0",
  "info": {
    "title": "Cosmic Universal API",
    "version": "4.33.0",
    "description": "Canonical HTTP contract for the Cosmic /api/v1 surface. This document is intentionally additive and is the first contract baseline for generated clients and staging smoke tests."
  },
  "servers": [
    { "url": "https://api.example.com", "description": "Production/staging placeholder" }
  ],
  "tags": [
    { "name": "health" },
    { "name": "auth" },
    { "name": "kernel" },
    { "name": "ai" }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness/diagnostic health",
        "responses": {
          "200": {
            "description": "Service health information",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "tags": ["health"],
        "summary": "Readiness for traffic",
        "responses": {
          "200": { "description": "Service is ready" },
          "503": { "description": "Service is not ready" }
        }
      }
    },
    "/api/v1/command": {
      "post": {
        "tags": ["kernel"],
        "summary": "Execute a canonical universe command",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CommandRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Command result" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["auth"],
        "summary": "Register a user",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthRegisterRequest" } } } },
        "responses": { "201": { "description": "User created" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Authenticate and create a session",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthLoginRequest" } } } },
        "responses": { "200": { "description": "Authenticated session" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "summary": "Refresh an authenticated session",
        "responses": { "200": { "description": "Refreshed session" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Logout and revoke the session",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Logout result" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["auth"],
        "summary": "Return the current authenticated user",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Current user" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/features": {
      "get": {
        "tags": ["kernel"],
        "summary": "List enabled feature flags",
        "responses": { "200": { "description": "Feature registry" } }
      }
    },
    "/api/v1/ai/analyze": {
      "post": {
        "tags": ["ai"],
        "summary": "Run semantic/AI analysis",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnalysisRequest" } } } },
        "responses": {
          "200": { "description": "Analysis result" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/observe": {
      "post": {
        "tags": ["kernel"],
        "summary": "Record a canonical observation",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ObservationRequest" } } } },
        "responses": { "200": { "description": "Recorded observation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ObservationResponse" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/analyze": {
      "post": {
        "tags": ["ai"],
        "summary": "Run canonical analysis",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnalysisRequest" } } } },
        "responses": { "200": { "description": "Analysis result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnalysisResponse" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/evaluate": {
      "post": {
        "tags": ["ai"],
        "summary": "Evaluate a canonical target",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvaluationRequest" } } } },
        "responses": { "200": { "description": "Evaluation result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnalysisResponse" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/query": {
      "post": {
        "tags": ["kernel"],
        "summary": "Query canonical universe records",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QueryRequest" } } } },
        "responses": { "200": { "description": "Query result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericObject" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/resource/{id}": {
      "get": {
        "tags": ["kernel"],
        "summary": "Read one canonical resource",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": { "200": { "description": "Resource", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericObject" } } } }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/resource/{id}/evidence": {
      "get": {
        "tags": ["kernel"], "summary": "List resource evidence", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": { "200": { "description": "Evidence list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericObject" } } } }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "tags": ["kernel"], "summary": "Attach evidence to a resource", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvidenceAttachmentRequest" } } } },
        "responses": { "200": { "description": "Evidence attached", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericObject" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/reviews": {
      "get": { "tags": ["kernel"], "summary": "List human reviews", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Review list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericObject" } } } }, "401": { "$ref": "#/components/responses/Error" } } },
      "post": { "tags": ["kernel"], "summary": "Create a human review", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewCreateRequest" } } } }, "responses": { "200": { "description": "Review", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericObject" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/reviews/{id}/transition": {
      "post": {
        "tags": ["kernel"], "summary": "Transition a human review", "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ReviewId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewTransitionRequest" } } } },
        "responses": { "200": { "description": "Updated review", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericObject" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v1/xrp/workspace": {
      "get": {
        "tags": ["kernel"], "summary": "Read the caller's bounded workspace projection", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Workspace projection", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericObject" } } } }, "401": { "$ref": "#/components/responses/Error" } }
      }
    }
  },
  "components": {
    "parameters": {
      "ResourceId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "ReviewId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }
    },
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "responses": {
      "Error": {
        "description": "Machine-readable API error",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "release"],
        "properties": {
          "status": { "type": "string" },
          "release": { "type": "string" },
          "environment": { "type": "string" },
          "storageDriver": { "type": "string", "enum": ["file", "postgres"] }
        }
      },
      "CommandRequest": {
        "type": "object",
        "required": ["command"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "target": { "type": "string" },
          "payload": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      },
      "AuthRegisterRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 1 },
          "password": { "type": "string", "minLength": 12 }
        },
        "additionalProperties": false
      },
      "AuthLoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 1 },
          "password": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "AnalysisRequest": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "caseId": { "type": "string" },
          "semanticObservation": { "type": "object" },
          "options": { "type": "object" }
        }
      },
      "ObservationRequest": {
        "type": "object",
        "properties": { "text": { "type": "string" }, "source": { "type": "string" }, "payload": { "type": "object", "additionalProperties": true }, "context": { "type": "object", "additionalProperties": true }, "mode": { "enum": ["semantic", "full"] }, "entityId": { "type": "string" } },
        "additionalProperties": false
      },
      "EvaluationRequest": {
        "type": "object",
        "properties": { "target": { "type": "string" }, "text": { "type": "string" }, "input": { "type": "object", "additionalProperties": true }, "mode": { "enum": ["mizan", "full"] }, "semanticObservation": { "type": "object", "additionalProperties": true } },
        "additionalProperties": false
      },
      "QueryRequest": {
        "type": "object",
        "properties": { "query": { "type": "string" }, "type": { "type": "string" }, "entityId": { "type": "string" }, "limit": { "type": "integer", "minimum": 1 } },
        "additionalProperties": false
      },
      "EvidenceAttachmentRequest": {
        "type": "object",
        "properties": { "evidenceId": { "type": "string" }, "sourceType": { "type": "string" }, "reference": { "type": "string" }, "status": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "payload": { "type": "object", "additionalProperties": true }, "supersedes": { "type": "string" }, "supersessionReason": { "type": "string" } },
        "additionalProperties": false
      },
      "ReviewCreateRequest": {
        "type": "object",
        "required": ["targetId"],
        "properties": { "targetId": { "type": "string", "minLength": 1 }, "assigneeId": { "type": "string" }, "gateDecision": { "type": "string" }, "evidenceRefs": { "type": "array", "items": { "type": "string" } } },
        "additionalProperties": false
      },
      "ReviewTransitionRequest": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "type": "string" }, "assigneeId": { "type": "string" }, "rationale": { "type": "string" }, "disposition": { "type": "string" } },
        "additionalProperties": false
      },
      "ObservationResponse": {
        "type": "object",
        "required": ["id", "kind", "status", "entityId", "event"],
        "properties": { "id": { "type": "string" }, "kind": { "const": "OBSERVATION" }, "status": { "const": "RECORDED" }, "entityId": { "type": "string" }, "event": { "type": "object", "additionalProperties": true } },
        "additionalProperties": true
      },
      "AnalysisResponse": {
        "type": "object",
        "required": ["id", "kind", "status", "mizan", "lifecycle", "reviewGate", "revelationScorecard", "witness"],
        "properties": { "id": { "type": "string" }, "kind": { "enum": ["ANALYSIS", "EVALUATION"] }, "status": { "type": "string" }, "mizan": { "type": ["object", "null"], "additionalProperties": true }, "lifecycle": { "type": ["object", "null"], "additionalProperties": true }, "reviewGate": { "type": "object", "additionalProperties": true }, "revelationScorecard": { "type": ["object", "null"], "additionalProperties": true }, "witness": { "type": "object", "additionalProperties": true } },
        "additionalProperties": true
      },
      "GenericObject": { "type": "object", "additionalProperties": true },
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" },
          "requestId": { "type": "string" },
          "request_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
