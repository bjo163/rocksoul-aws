# Storage
STORAGE_DRIVER=postgres

# PostgreSQL (preferred over hardcoding credentials in config files)
PGHOST=localhost
PGPORT=5432
PGDATABASE=moonwitness
PGUSER=postgres
PGPASSWORD=change-me

# Optional: use a single connection string instead of PG* variables
# DATABASE_URL=postgres://postgres:change-me@localhost:5432/moonwitness

# Authentication and browser sessions
# Trusted bootstrap identity. Public registration cannot set a RID.
MOONWITNESS_ADMIN_RID=RID-REPLACE-WITH-VERIFIED-OPERATOR
# Required in production. Use a long random value from a managed secret store.
JWT_SECRET=replace-with-a-long-random-secret
# Optional token claim constraints. Configure both consistently on every API instance.
MW_JWT_ISSUER=moonwitness-api
MW_JWT_AUDIENCE=moonwitness-clients
# Short-lived access token and rotating refresh session lifetimes (milliseconds).
MW_ACCESS_TOKEN_TTL_MS=900000
MW_REFRESH_TOKEN_TTL_MS=2592000000
# Browser origins must be explicit and comma-separated outside local development.
MW_CORS_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:4174,http://127.0.0.1:4175,http://127.0.0.1:4176
MW_COOKIE_SECURE=0
MW_COOKIE_SAME_SITE=Lax

# HTTP protection. Replace the local limiter with a shared store for multi-instance deployment.
MW_RATE_LIMIT_PER_MINUTE=600
MW_AUTH_RATE_LIMIT_PER_MINUTE=30
MW_AI_RATE_LIMIT_PER_MINUTE=30
MW_WRITE_RATE_LIMIT_PER_MINUTE=120
MW_RATE_LIMIT_MAX_BUCKETS=10000
# Set only behind a trusted reverse proxy that replaces forwarded headers.
MW_TRUST_PROXY=0

# Single-node Witness runtime (v4.20; v4.19 witness baseline retained)
WITNESS_ID=SERVICE-WITNESS-001
# Required in production. In development only, an auto-generated local secret is stored under MOONWITNESS_DATA_DIR/witness/.
# WITNESS_KEY_PASSWORD=replace-with-a-long-random-secret

# Automatic signed checkpoint after each Mizan witness commitment. Set to 0 for manual-only checkpoints.
WITNESS_AUTO_CHECKPOINT=1
